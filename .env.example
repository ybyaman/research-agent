# Kopyala: cp .env.example .env
# real = Ollama'ya bağlanır, mock = LLM olmadan sahte ajanlarla çalışır
LLM_MODE=mock
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT=120
MAX_CONCURRENCY=2
MAX_ROUNDS=2
MAX_SUBQUESTIONS=5
SOURCES_PER_QUESTION=4
TAVILY_API_KEY=
