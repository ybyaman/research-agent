# Kopyala: cp .env.example .env
# real = Ollama'ya bağlanır, mock = LLM olmadan sahte ajanlarla çalışır
LLM_MODE=mock
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT=120
# Aynı anda çalışabilecek graf node'u (ör. paralel Searcher'lar)
MAX_CONCURRENCY=4
# Ollama'ya aynı anda gönderilecek en fazla istek. Ollama sunucusundaki OLLAMA_NUM_PARALLEL ile aynı tutun.
LLM_MAX_PARALLEL=1
# Bağlantı hatası / zaman aşımı / 5xx durumunda yeniden deneme sayısı
LLM_HTTP_RETRIES=2
MAX_ROUNDS=2
MAX_SUBQUESTIONS=5
SOURCES_PER_QUESTION=4
TAVILY_API_KEY=
